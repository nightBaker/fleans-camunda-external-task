<Project>
  <PropertyGroup>
    <!-- Package version of this plugin. Tracks the Fleans engine release it is built against. -->
    <VersionPrefix>0.6.0</VersionPrefix>
    <!-- Fleans plugin-author packages (Fleans.Worker + abstractions) this plugin compiles against.
         0.6.0 is the first release with IWorkflowInstanceCallback.GetVariablesIfActive (#816). -->
    <FleansVersion>0.6.0</FleansVersion>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <Authors>nightBaker</Authors>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/nightBaker/fleans-camunda-external-task</RepositoryUrl>
    <PackageProjectUrl>https://github.com/nightBaker/fleans-camunda-external-task</PackageProjectUrl>
  </PropertyGroup>
</Project>
